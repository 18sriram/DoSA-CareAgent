# Copy to .env and fill in. Never commit .env.
GNANI_API_KEY=your-gnani-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
TTS_VOICE=Nalini
STT_MODEL=
PATIENT_LANGUAGE=te-IN

HOSPITAL_NAME=City Orthopaedic Hospital
# The address patients' QR codes point to. Use your real https address in production.
PUBLIC_URL=http://localhost:8000
HOSPITAL_DB=data/hospital.db
AUDIO_DIR=data/audio_cache
# Backups go here. Keep it inside data/ so a Docker volume preserves it, and copy it OFF this machine too.
BACKUP_DIR=data/backups

# Production: serve over HTTPS and set COOKIE_SECURE=1 (and TRUST_PROXY=1 only behind your own reverse proxy).
COOKIE_SECURE=0
TRUST_PROXY=0
# Encryption of clinical data inside the database. Create a key with: python manage.py generate-key
# Keep a copy of it somewhere safe and separate from the database and backups: without it, encrypted data cannot be read.
DATA_KEY=
# To rotate keys, list the NEW key first, then the old one(s):  DATA_KEYS=<new>,<old>  then run: python manage.py encrypt-data

# Hospital local time, used for appointment slots.
TIMEZONE=Asia/Kolkata
SESSION_HOURS=8
SESSION_IDLE_MINUTES=60
VISIT_TOKEN_HOURS=24
CHECKIN_TOKEN_DAYS=30
